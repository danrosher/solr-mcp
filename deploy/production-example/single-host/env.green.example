# Copy to env.green, edit, then:  docker compose -p solr-mcp-green --env-file env.green up -d
CLUSTER=green
MCP_IMAGE=registry.example.com/solr-mcp:1.0.0-yourtag
MCP_PORT=8081
OAUTH2_ISSUER_URI=https://idp.example.com/realms/solr
# Fixed subnets, one /24 per network. Must not overlap your LAN, Docker's other networks, or green.
LINK_SUBNET=10.88.20.0/24
EGRESS_SUBNET=10.88.21.0/24
UPSTREAM_SUBNET=10.88.22.0/24
# This cluster's nodes, for nginx (file) and the firewall (list). KEEP THEM IN SYNC.
UPSTREAM_CONF=./conf/green-upstream.conf
SOLR_NODES="10.2.0.11 10.2.0.12 10.2.0.13"
SOLR_PORTS="8983"
