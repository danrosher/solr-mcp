# Copy to env.blue, edit, then:  docker compose -p solr-mcp-blue --env-file env.blue up -d
CLUSTER=blue
MCP_IMAGE=registry.example.com/solr-mcp:1.0.0-yourtag
MCP_PORT=8080
OAUTH2_ISSUER_URI=https://idp.example.com/realms/solr
# Fixed subnets, one /24 per network. Must not overlap your LAN, Docker's other networks, or green.
LINK_SUBNET=10.88.10.0/24
EGRESS_SUBNET=10.88.11.0/24
UPSTREAM_SUBNET=10.88.12.0/24
# This cluster's nodes, for nginx (file) and the firewall (list). KEEP THEM IN SYNC.
UPSTREAM_CONF=./conf/blue-upstream.conf
SOLR_NODES="10.1.0.11 10.1.0.12 10.1.0.13"
SOLR_PORTS="8983"
