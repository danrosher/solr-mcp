# Copy to env.test. One environment per file. Run:
#   docker compose -p solr-mcp-test --env-file env.test -f compose.yaml up -d --build
CLUSTER=test
MCP_IMAGE=registry.example.com/solr-mcp:1.0.0-yourtag
MCP_PORT=8081
OAUTH2_ISSUER_URI=https://idp.example.com/realms/solr
# Fixed subnets, one /24 per network. Must not overlap your LAN, Docker's other networks, or another env.
LINK_SUBNET=10.88.20.0/24
EGRESS_SUBNET=10.88.21.0/24
UPSTREAM_SUBNET=10.88.22.0/24

# This environment's OWN ZooKeeper and traffic znode (test and test differ).
ZK_HOSTS=zk-test-1:2181,zk-test-2:2181,zk-test-3:2181
ZK_PATH=/CHANGE/ME/traffic.properties            # value like:  blue=120  green=90
COLOURS_CONF=./conf/test-colours.conf            # colour -> Solr nodes (see that file)
# Optional. Used only on a COLD start when ZooKeeper cannot be read. Unset = wait for ZooKeeper.
#DEFAULT_WEIGHTS=blue=1,green=1

# For the firewall (../single-host/firewall/apply.sh): EVERY node of EVERY colour, so the MCP is
# blocked from all of them whichever colour is receiving traffic. Keep in sync with COLOURS_CONF.
SOLR_NODES="10.1.0.11 10.1.0.12 10.1.0.13 10.2.0.11 10.2.0.12 10.2.0.13"
SOLR_PORTS="8983"
# Also keep the MCP off ZooKeeper (host:port, space separated).
EXTRA_BLOCK="10.9.1.1:2181 10.9.1.2:2181 10.9.1.3:2181"
